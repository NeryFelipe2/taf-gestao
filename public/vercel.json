{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/marko",
      "destination": "/marko.html"
    },
    {
      "source": "/ciclo",
      "destination": "/ciclo.html"
    },
    {
      "source": "/erp",
      "destination": "/erp.html"
    }
  ],
  "crons": [
    {
      "path": "/api/resumo?quando=diario",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/resumo?quando=semanal",
      "schedule": "30 10 * * 1"
    }
  ]
}
