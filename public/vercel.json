{
  "functions": {
    "api/assistente.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/marko",
      "destination": "/marko.html"
    },
    {
      "source": "/ciclo",
      "destination": "/ciclo.html"
    },
    {
      "source": "/erp",
      "destination": "/erp.html"
    }
  ]
}
